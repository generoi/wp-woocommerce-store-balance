msgstr "Gavekort er gyldige i"

#: src/Modules/Admin.php:698
msgid "Store credit is valid for"
msgstr "Tilgodehavender er gyldige i"

#: src/Modules/Admin.php:701
msgid "days"
msgstr "dager"

#: src/Modules/Admin.php:702
msgid ""
"0 means no expiry. Applies to cards created from now on; existing ones keep "
